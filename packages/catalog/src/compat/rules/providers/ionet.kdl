// Provider-wire compat for "ionet" (IO Intelligence by io.net).

provider "ionet" {
	default-model "openai/gpt-oss-20b"
	env "IONET_API_KEY"
	// The /models catalog is readable without a key, so the provider and its
	// live model list must be reachable before login.
	allow-unauthenticated #true
	dynamic-models-authoritative #true
	// Deliberately NO `discovery` node, for charm-hyper's reason: that node is
	// what enrolls a provider in generate-models.ts, and this catalog drifts
	// day to day — generating would freeze one api.intelligence.io.solutions
	// snapshot into models.json, contradicting the runtime-only contract that
	// dynamic-models-authoritative establishes with zero bundled seed rows.
}
